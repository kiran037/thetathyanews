# ===================================================================
# TheTathyaNews — Environment Configuration Template
# Copy this file to .env and configure for your local/production environment
# NEVER commit actual passwords, API keys, or secrets to version control.
# ===================================================================

# Database Connection (Supabase PostgreSQL)
# Transaction pooler (port 6543) or Session pooler / Direct (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?sslmode=require

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ASSETS_URL=

# Session Authentication Security
# Generate a cryptographically strong 64-character random secret for production
SESSION_SECRET=your_super_secret_session_key_change_this_in_production

# Cloud Object Storage (Supabase Storage)
# Required for production persistent media uploads across serverless containers
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=media

# Local Storage Fallback (Development only)
UPLOAD_PATH=uploads

# Email Service (Brevo / Sendinblue API)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME=TheTathyaNews
BREVO_SENDER_EMAIL=noreply@example.com
